<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MathGame.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="30,0" Spacing="25">

            <Border StrokeShape="RoundRectangle 10,10,10,10"
                    Background="#2B0B98"
                    WidthRequest="230"
                    Margin="60"
                    Padding="30">
                <VerticalStackLayout HorizontalOptions="Center">
                    <Label Text="SCORE"
                           TextColor="White"
                           FontSize="30"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="lbScore"
                           Text="0"
                           FontSize="25"
                           TextColor="White"
                           Background="Black"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <Image Source="mascote.png"
                   HeightRequest="10"
                   Aspect="AspectFit" />
            <Button x:Name="BtnJogar"
                    Text="Jogar"
                    MinimumWidthRequest="140"
                    HorizontalOptions="Center"
                    Margin="0, 180, 0, 0"
                    Clicked="BtnJogar_Clicked" />

            <Button x:Name="BtnZerar"
                    Text="Zerar"
                    HorizontalOptions="Center"
                    MinimumWidthRequest="140"
                    Clicked="BtnZerar_Clicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
